AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/REPLACE_WITH_ACCOUNT_ID/queueflow-jobs
S3_RESULTS_BUCKET=replace-with-your-queueflow-results-bucket

WORKER_STALE_AFTER_SECONDS=120
WORKER_RECOVERY_INTERVAL_MS=30000
PRIORITY_AGING_SECONDS=60
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LOCK_TIMEOUT_SECONDS=30
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
SQS_VISIBILITY_TIMEOUT_SECONDS=120
SQS_VISIBILITY_RENEWAL_SECONDS=30
RETRY_BASE_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=60
RESOURCE_MISMATCH_DELAY_SECONDS=30
